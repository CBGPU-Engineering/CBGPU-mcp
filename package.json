{
  "name": "cbgpu-deploy-mcp",
  "version": "1.2.0",
  "description": "CBGPU frontend and server deployments for Codex and Claude Code",
  "type": "module",
  "bin": {
    "cbgpu-deploy-mcp": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit && node scripts/check-source-languages.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.ts",
    "build:native": "node scripts/build-native.ts",
    "test:native": "node test/native-stdio.ts",
    "schema:native": "node scripts/export-native-schema.ts",
    "package:native": "node scripts/package-native-candidate.ts && node scripts/verify-native-candidate.ts"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CBGPU-Engineering/CBGPU-mcp.git"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "dotenv": "^18.0.10",
    "esbuild": "^0.28.2",
    "proper-lockfile": "^4.1.2",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
