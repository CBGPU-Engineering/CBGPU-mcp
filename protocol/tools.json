  {
    "name": "create_frontend",
    "description": "Create and immediately deploy a GitHub frontend. Defaults to branch main, framework auto. Returns an asynchronous deployment ID; poll its status. Set environment variables using the environment tools before an explicit redeploy.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,34}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\/?$"
        },
        "branch": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
        },
        "framework": {
          "type": "string",
          "enum": [
            "auto",
            "next",
            "vite",
            "astro",
            "static",
            "other"
          ]
        },
        "root_directory": {
          "type": "string",
          "maxLength": 200
        },
        "output_directory": {
          "type": "string",
          "maxLength": 200
        },
        "install_command": {
          "type": "string",
          "maxLength": 500
        },
        "build_command": {
          "type": "string",
          "maxLength": 500
        },
        "auto_deploy": {
          "type": "boolean"
        },
        "env_file": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "repository"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
