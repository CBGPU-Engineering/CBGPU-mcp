  {
    "name": "create_server",
    "description": "Create a GitHub, Docker image or Docker Compose server. Starts asynchronously without admin approval. Compose preserves persistent volumes. Defaults to private access. Public exposure requires access_scope public; domain is server-<first8id>.server.cbgpu.com until set_server_domain.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "mode": {
          "type": "string",
          "enum": [
            "git",
            "docker",
            "compose"
          ]
        },
        "settings": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "git_url": {
              "type": "string",
              "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\/?$"
            },
            "git_branch": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
            },
            "docker_image": {
              "type": "string",
              "maxLength": 200
            },
            "runtime": {
              "type": "string",
              "enum": [
                "node20",
                "node18",
                "python311",
                "python39"
              ]
            },
            "run_command": {
              "type": "string",
              "maxLength": 4000
            },
            "container_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "cpu_limit": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 4
            },
            "memory_limit": {
              "type": "string",
              "enum": [
                "128m",
                "256m",
                "512m",
                "1g",
                "2g",
                "4g",
                "8g",
                "16g"
              ]
            },
            "access_scope": {
              "type": "string",
              "enum": [
                "private",
                "school",
                "public"
              ]
            },
            "root_directory": {
              "type": "string",
              "maxLength": 200
            },
            "runtime_preset": {
              "type": "string",
              "enum": [
                "node22",
                "node20",
                "node18",
                "python312",
                "python311",
                "python39",
                "java21",
                "java17",
                "go1",
                "dotnet10"
              ]
            },
            "compose_file": {
              "type": "string",
              "maxLength": 200
            },
            "gateway_service": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "storage_gb": {
              "type": "integer",
              "minimum": 40,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "env_file": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "mode",
        "settings"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
